      "item": [
        {
          "name": "Save quiz attempt (50%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "var d = pm.response.json().data;",
                  "pm.test('Graded on the server', () => { pm.expect(d.attempt.score).to.eql(1); pm.expect(d.attempt.percentage).to.eql(50); pm.expect(d.bestScore).to.eql(50); });",
                  "pm.test('50% does not start a streak', () => pm.expect(d.streak.current).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
