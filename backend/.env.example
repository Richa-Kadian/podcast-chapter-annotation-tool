# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env — it is listed in .gitignore.

# Port the API listens on (hosting platforms like Render set this automatically).
# Not 5000: on macOS that port is taken by AirPlay Receiver.
PORT=5050

# development | production | test
NODE_ENV=development

# MongoDB connection string, e.g. from MongoDB Atlas -> Connect -> Drivers
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/momento?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/momento

# Long random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Where the frontend is served from (comma-separated if more than one).
# Any http://localhost:<port> origin is also allowed when NODE_ENV is not production.
FRONTEND_URL=http://localhost:5500

# Enables the "1-Click Evaluation Demo Access" button on the login page.
# Signs everyone who clicks it into one shared demo account.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=student@momento.ai
